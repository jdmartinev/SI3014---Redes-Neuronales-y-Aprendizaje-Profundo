    " \n",
    "# Pre-tokenizador: split por espacios\n",
    "tokenizer.pre_tokenizer = Whitespace()\n",
    " \n",
    "trainer = WordLevelTrainer(\n",
    "    vocab_size=VOCAB_SIZE,\n",
